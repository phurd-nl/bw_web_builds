+    // in a /login -> /sso -> /login loop. A later visit (e.g. logout hours
+    // later) is past the window and auto-redirects normally.
+    const ATTEMPT_KEY = "nextvaultSsoAutoRedirectAt";
+    try {
+      const now = Date.now();
+      const last = parseInt(window.sessionStorage.getItem(ATTEMPT_KEY) ?? "0", 10);
+      if (last && now - last < 10000) {
+        window.sessionStorage.removeItem(ATTEMPT_KEY);
+        return false;
+      }
+      window.sessionStorage.setItem(ATTEMPT_KEY, String(now));
+    } catch {
+      // sessionStorage unavailable (private mode/etc.) — proceed without guard.
+    }
+
+    await this.router.navigate(["/sso"], { queryParams: { identifier: "nextvault" } });
+    return true;
+  }
